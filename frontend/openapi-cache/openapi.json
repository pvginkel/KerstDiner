{
  "components": {
    "schemas": {
      "ApiErrorResponseSchema.c2a0d71": {
        "description": "The error envelope every error handler answers with.\n\nIt mirrors ``build_error_response()`` in ``app/utils/flask_error_handlers.py``;\nchange both together. Use it to document error responses in ``@api.validate``,\nfor example ``HTTP_502=ApiErrorResponseSchema`` on an endpoint that calls an\nexternal service. One handler differs: a ``pydantic.ValidationError`` raised\nin a handler answers 400 with ``details.errors``, a list of\n``{\"message\", \"field\"}``, instead of ``details.message``.",
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Machine-readable error code; every business-logic exception sets one",
            "example": "AUTHORIZATION_FAILED",
            "title": "Code"
          },
          "correlationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The request's correlation ID, when it has one",
            "title": "Correlationid"
          },
          "details": {
            "$ref": "#/components/schemas/ApiErrorResponseSchema.c2a0d71.ApiErrorDetailsSchema",
            "description": "Error details"
          },
          "error": {
            "description": "Error message",
            "example": "Authorization failed",
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error",
          "details"
        ],
        "title": "ApiErrorResponseSchema",
        "type": "object"
      },
      "ApiErrorResponseSchema.c2a0d71.ApiErrorDetailsSchema": {
        "description": "The ``details`` object of the error envelope ``build_error_response`` builds.",
        "properties": {
          "message": {
            "description": "Human-readable error description",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ApiErrorDetailsSchema",
        "type": "object"
      },
      "ForceErrorQuerySchema.e510e64": {
        "description": "Query parameters for force-error endpoint.",
        "properties": {
          "status": {
            "description": "HTTP status code to return on next /api/auth/self request",
            "title": "Status",
            "type": "integer"
          }
        },
        "required": [
          "status"
        ],
        "title": "ForceErrorQuerySchema",
        "type": "object"
      },
      "HealthResponse.d817ae2": {
        "description": "Liveness and drain response.",
        "properties": {
          "ready": {
            "description": "Whether the service is ready to handle requests",
            "examples": [
              true,
              false
            ],
            "title": "Ready",
            "type": "boolean"
          },
          "status": {
            "description": "Health status message",
            "examples": [
              "alive",
              "unauthorized"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "ready"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadyzResponse.d817ae2": {
        "description": "Readiness response: the overall verdict and every check.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReadyzResponse.d817ae2.ReadinessCheckSchema"
            },
            "description": "Every registered check by name; empty while shutting down",
            "title": "Checks",
            "type": "object"
          },
          "ready": {
            "description": "Whether the service takes traffic; false exactly when readyz answers 503",
            "title": "Ready",
            "type": "boolean"
          },
          "stage": {
            "description": "Deployment stage (STAGE)",
            "examples": [
              "prd",
              "local-dev"
            ],
            "title": "Stage",
            "type": "string"
          },
          "status": {
            "description": "ok: every check passed. degraded: a non-critical check failed (200). not_ready: a critical check failed (503). shutting_down: draining (503).",
            "enum": [
              "ok",
              "degraded",
              "not_ready",
              "shutting_down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "ready",
          "stage",
          "checks"
        ],
        "title": "ReadyzResponse",
        "type": "object"
      },
      "ReadyzResponse.d817ae2.ReadinessCheckSchema": {
        "description": "Result of one readiness check.",
        "properties": {
          "critical": {
            "description": "Whether a failure of this check makes readyz answer 503",
            "title": "Critical",
            "type": "boolean"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Why the check failed, or a note on its result",
            "examples": [
              "connection failed",
              "2 migrations pending",
              "timed out after 0.8 s"
            ],
            "title": "Detail"
          },
          "status": {
            "description": "ok, error, or disabled (deliberately not configured; never fails readiness)",
            "enum": [
              "ok",
              "error",
              "disabled"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "critical"
        ],
        "title": "ReadinessCheckSchema",
        "type": "object"
      },
